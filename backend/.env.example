# SQLite for local development
DATABASE_URL=sqlite:///./agrofarm.db
# PostgreSQL (used by docker-compose)
# DATABASE_URL=postgresql+psycopg2://agrofarm:agrofarm@db:5432/agrofarm

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SIMULATOR_ENABLED=true
SIMULATOR_TICK_SECONDS=3
SIMULATOR_SPEED_FACTOR=180
SEED_DEMO_DATA=true

# Hosted AI assistant (create a key in Google AI Studio; never commit the key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
